# Корневой `.env`: общие секреты и удобные имена для скриптов (parity / telegram check).
# API при старте читает сначала этот файл, затем `services/api/.env` (API перекрывает корень).
# Канон для процесса API после bootstrap: INTERNAL_ANALYTICS_TOKEN, TELEGRAM_API_BASE_URL, TELEGRAM_BOT_TOKEN, TELEGRAM_ALERT_CHAT_ID.

APP_ENV=local
DATABASE_URL="postgresql://user:password@localhost:5432/mywave"
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars

# Пилот (дублируйте в services/api/.env для API): /metrics/pilot-kpi, shadow-учёт
# PILOT_MODE_ENABLED=1

# Скрипты `pnpm run check:*` (TARGET_* — не секреты имён; значения храните только локально)
TARGET_BASE_URL=http://localhost:3001
# TARGET_ADMIN_TOKEN — не храните в .env; получайте через admin login и передавайте в окружение сеанса при необходимости
TARGET_INTERNAL_TOKEN=change-me-same-as-internal-analytics-token

# Вариант A: канонические имена (рекомендуется дублировать в services/api/.env для API)
# INTERNAL_ANALYTICS_TOKEN=change-me-long-random
# CAMP_API_TOKEN=change-me-long-random-camp-feed-token
# TELEGRAM_API_BASE_URL=https://api.telegram.org
# TELEGRAM_BOT_TOKEN=<YOUR_BOT_TOKEN>
# Legacy migration fallback only; contains a secret:
# TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org/bot<YOUR_BOT_TOKEN>
# TELEGRAM_ALERT_CHAT_ID=123456789
# Контент-конвейер (E): owner в Telegram, вебхук, опциональный отдельный chat; голос=OpenAI
# TELEGRAM_CONTENT_OWNER_CHAT_ID=123456789
# Comma-separated Telegram user IDs allowed to submit /source in the owner chat. Empty disables the command.
TELEGRAM_SOURCE_PROPOSAL_USER_IDS=
# CONTENT_PIPELINE_TELEGRAM_WEBHOOK_TOKEN=long-random-path-secret
# OPENAI_API_KEY=sk-...

# Analytics Agent v1 (`pnpm run agent:analytics:run`): /metrics/content-entries → LLM → Telegram
# API_URL=http://localhost:3001
# INTERNAL_ANALYTICS_TOKEN=change-me-long-random
# (опционально отдельный чат) TELEGRAM_ANALYTICS_AGENT_CHAT_ID=123456789
# OPENAI_ANALYTICS_MODEL=gpt-4o-mini
# TG_BOT_TOKEN=   или TELEGRAM_BOT_TOKEN
# TG_CHAT_ID=     приоритет: TG_CHAT_ID > TELEGRAM_ANALYTICS_AGENT_CHAT_ID > TELEGRAM_ALERT_CHAT_ID > OWNER_CHAT_ID
# ANALYTICS_AGENT_CRON=0 10 * * *
# ANALYTICS_AGENT_TZ=Europe/Moscow
# Отдельный analytics:cron отключён — см. orchestrator:cron в services/agents.

# Orchestrator (production hardening): единая точка входа + run registry + Telegram /approve
# ORCHESTRATOR_AGENT_CRON=0 12 * * *
# ORCHESTRATOR_AGENT_TZ=Europe/Moscow
# Пороги сигналов и лимиты (целые числа; по умолчанию 5 / 1 / 5 / 3)
# ORCHESTRATOR_STRONG_THRESHOLD=5
# ORCHESTRATOR_WEAK_THRESHOLD=1
# ORCHESTRATOR_MAX_STRONG_SIGNALS=5
# ORCHESTRATOR_MAX_ACTIONS_PER_RUN=3
# Learning loop: topic_outcomes.json, scoring, калибровка confidence, cost control
# ORCHESTRATOR_MAX_NEW_TOPICS_PER_DAY=3
# ORCHESTRATOR_MAX_REPEAT_TOPIC_WINDOW_DAYS=7
# ORCHESTRATOR_LEARNING_HIGH_CONF=0.7

# Вариант B: короткие имена для Telegram — API соберёт канон сам при старте
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
OWNER_CHAT_ID=123456789
NEXT_PUBLIC_TELEGRAM_UPDATES_INVITE_LINK=https://t.me/+yourInviteHash

ANALYTICS_ENABLED=1
ANALYTICS_ALERT_COOLDOWN_SECONDS=3600
TRAVELER_KEY_SALT=long-random-server-only-salt-for-booking-lead-hash
CAMP_API_TOKEN=change-me-long-random-camp-token

# Ingestion (долгий сбор: положить в `services/api/.env` — см. `packages/config/src/env.ts`)
# INGESTION_DAILY_ENABLED=1
# INGESTION_DAILY_HOUR_LOCAL=8
# За один daily run обрабатывается не более 5 due-источников (1..100).
# INGESTION_DAILY_SOURCE_LIMIT=5
# Автопубликация по умолчанию выключена; включать только явно: INGESTION_AUTOPUBLISH_ENABLED=1

# --- Docker prod (корневой .env.production дублирует часть ключей для compose; API см. services/api/.env.production) ---
# PILOT_MODE_ENABLED=1
# LEGAL_CONSENT_POLICY_VERSION=pilot-v1
# SEED_DEMO_CATALOG=0
# INGESTION_AUTOPUBLISH_ENABLED=0

# Отдельный ежедневный Telegram-дайджест pending источников. Не запускает ingestion.
# SOURCE_PROPOSAL_DIGEST_DAILY_ENABLED=1
# SOURCE_PROPOSAL_DIGEST_DAILY_HOUR_LOCAL=9
