// Prisma schema. Source of truth: db_schema_draft.csv, db_relationship_notes.md, audit_log_spec.md
// Sprint 1: users, organizers, audit_logs only.

generator client {
  provider      = "prisma-client-js"
  // API Docker: Debian bookworm (OpenSSL 3). Alpine+musl часто остаётся на движке libssl.so.1.1 без compat-пакета.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Content pipeline (канон: docs/architecture/CONTENT_PIPELINE_DATA_MODEL.md) — сквозной content_item_id ---

enum ContentWorkflowStatus {
  ingest_collected
  draft
  pending_owner_review
  /// Ожидаем ввод owner (текст/голос) для новой версии draft.
  rewrite_requested
  approved
  scheduled
  publishing
  published
  failed
  rejected
  skipped
  archived
}

enum RawItemParseStatus {
  pending
  ok
  partial
  failed
  skipped_duplicate
}

enum ContentDraftType {
  telegram_post
  vk_post
  facebook_post
  site_announce
  blog_post
  program_card_structured
}

enum ContentDraftStatus {
  draft
  pending_owner_review
  ready
  superseded
  failed
}

enum ContentOwnerDecision {
  pending
  approved
  rewrite_requested
  rejected
  deferred
  skipped
}

enum ContentPublicationChannel {
  telegram_channel
  vk
  facebook
  site_blog
  site_landing
}

enum ContentPublishState {
  pending
  scheduled
  publishing
  published
  failed
  cancelled
  skipped
}

// Seed: pnpm --filter api db:seed (creates admin@mywave.local)

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  role         String // admin | organizer | user (Sprint 1: admin only)
  passwordHash String? // for admin login only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Organizer {
  id                   String                          @id @default(cuid())
  displayName          String
  legalStatus          String? // self-employed / ИП / ООО
  contactEmail         String
  contactPhone         String?
  responseScore        Int? // optional metric
  verificationStatus   String // listed | checked | verified | trusted_by_platform | paused | rejected
  onboardingStatus     String                          @default("applied") // applied | under_review | approved | contract_pending | contract_signed | billing_connected | active | limited | suspended
  billingStatus        String                          @default("not_connected") // not_connected | billing_connected | suspended
  privilegeStatus      String                          @default("limited") // limited | active | suspended
  commissionRateBps    Int                             @default(300) // Fair Success Fee default 3%
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  programs             Program[]
  leads                Lead[]
  bookings             Booking[]
  verificationEvidence OrganizerVerificationEvidence[]
  incidents            Incident[]
  reviews              Review[]
  commissions          Commission[]
  sources              Source[]                        @relation("SourceOrganizer")
  payments             Payment[]
  refunds              Refund[]
  billingProfile       OrganizerBillingProfile?
  contracts            OrganizerContract[]
  billingStatements    BillingStatement[]
  scoreSnapshots       OrganizerScoreSnapshot[]
  reviewRequests       ReviewRequest[]
  outreachCampaigns    OrganizerOutreachCampaign[]
  contactChannels      OrganizerContactChannel[]
  telegramAccounts     OrganizerTelegramAccount[]
  telegramLeadAttempts TelegramLeadAttempt[]

  @@map("organizers")
}

/// Коммерческий слой сделки (1:1 с booking). Статусы: new | contacted | confirmed | completed | canceled
model Deal {
  id                  String       @id @default(cuid())
  bookingId           String       @unique
  contentItemId       String?
  dealStatus          String       @default("new")
  dealAmountRub       Int          @default(0)
  /// Процент, целое (3 = 3%)
  commissionRatePct   Int          @default(3)
  commissionAmountRub Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  booking             Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contentItem         ContentItem? @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([contentItemId])
  @@index([dealStatus])
  @@map("deals")
}

// program_card_schema.md, db_schema_draft. publish_status: canonical_status_models (Program Publication Status)
model Program {
  id                      String                 @id @default(cuid())
  organizerId             String
  title                   String
  discipline              String
  region                  String
  exactLocation           String?
  startDate               DateTime
  endDate                 DateTime
  durationDays            Int
  formatType              String? // tour | camp | clinic | training | ...
  audienceFit             String?                @db.Text
  levelRequired           String? // beginner | intermediate | advanced | expert
  riskLevel               String? // low | medium | high | extreme (safety)
  priceFromRub            Int?
  capacityTotal           Int?
  spotsAvailable          Int?
  isStarred               Boolean                @default(false)
  currency                String?                @default("RUB")
  inclusions              String?                @db.Text
  exclusions              String?                @db.Text
  gearRequirements        String?                @db.Text
  medicalLimitations      String?                @db.Text // safety
  itineraryDayByDay       String?                @db.Text
  organizerName           String? // denorm for display
  trustReason             String?                @db.Text
  reviewsSummary          String?                @db.Text
  cancellationRules       String?                @db.Text // required for publish
  whatHappensAfterBooking String?                @db.Text
  cta                     String?
  // Canonical publish intake: organizer_form | admin_manual | email | telegram | sheets_csv | seed | ingestion_auto
  intakeSource            String?
  // Данные с ingestion без ручного approve
  autoPublished           Boolean                @default(false)
  sourceId                String?
  // denorm: instagram | telegram | rss | site
  sourceType              String?
  sourceUrl               String?                @db.Text
  ingestedAt              DateTime?
  updatedFromSourceAt     DateTime?
  // auto_pending | ok | flagged
  reviewStatus            String                 @default("ok")
  publishStatus           String // draft | internal_review | needs_fix | approved | published | paused | archived
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  organizer               Organizer              @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  source                  Source?                @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  media                   ProgramMedia[]
  leads                   Lead[]
  bookings                Booking[]
  reviews                 Review[]
  incidents               Incident[]
  commissions             Commission[]
  payments                Payment[]
  refunds                 Refund[]
  publishedPrograms       PublishedProgram[]
  scoreSnapshots          ProgramScoreSnapshot[]
  reviewRequests          ReviewRequest[]
  contentItems            ContentItem[]
  telegramLeadAttempts    TelegramLeadAttempt[]

  @@index([sourceId])
  @@map("programs")
}

model Source {
  id                   String          @id @default(cuid())
  type                 String // instagram | telegram | rss | site
  name                 String
  urlOrHandle          String
  discipline           String?
  country              String?
  region               String?
  language             String?
  priority             Int             @default(100)
  trustScore           Float           @default(0.5)
  parserProfile        String?
  // Ключ адаптера/парсера (например telegram_channel_html). См. ingestion adapters.
  adapterKey           String?
  fetchIntervalMinutes Int             @default(60)
  isActive             Boolean         @default(true)
  lastCheckedAt        DateTime?
  lastSuccessAt        DateTime?
  metaJson             Json?
  organizerId          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  organizer            Organizer?      @relation("SourceOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  programs             Program[]
  runs                 SourceRun[]
  rawItems             RawItem[]
  contentMetrics       ContentMetric[]

  @@index([type, isActive])
  @@map("sources")
}

/// A reviewed intake queue. A proposal is deliberately not an active ingestion
/// source: accepting it and running collection remain explicit operator steps.
model SourceProposal {
  id              String   @id @default(cuid())
  normalizedUrl   String
  detectedType    String // instagram | telegram | rss | site
  displayName     String?
  organizerName   String?
  notes           String?  @db.Text
  submittedVia    String // admin | telegram
  submittedBy     String?
  status          String   @default("pending") // pending | approved | rejected
  rejectionReason String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([normalizedUrl])
  @@map("source_proposals")
}

model SourceRun {
  id           String    @id @default(cuid())
  sourceId     String
  runType      String    @default("collect") // collect | normalize | dedup | publish
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String // running | success | partial | failed
  itemsFound   Int       @default(0)
  itemsCreated Int       @default(0)
  errorMessage String?   @db.Text
  metaJson     Json?
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  rawItems     RawItem[]

  @@index([sourceId, startedAt])
  @@map("source_runs")
}

/// Durable ownership of a once-per-day scheduler run. This survives API restarts
/// and prevents two application instances from running the same daily pipeline.
model SchedulerDailyRun {
  id             String    @id @default(cuid())
  jobKey         String
  dayKey         String
  status         String    @default("running") // running | success | failed
  leaseToken     String
  leaseExpiresAt DateTime
  completedAt    DateTime?
  errorMessage   String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([jobKey, dayKey])
  @@index([status, leaseExpiresAt])
  @@map("scheduler_daily_runs")
}

model RawItem {
  id             String             @id @default(cuid())
  sourceId       String
  sourceRunId    String?
  externalItemId String?
  sourceType     String
  sourceUrl      String?
  authorName     String?
  publishedAt    DateTime?
  rawTitle       String?            @db.Text
  rawText        String?            @db.Text
  rawMediaJson   Json?
  rawPayloadJson Json?
  /// Стабильный дедуп-ключ внутри источника (тот же смысл, что dedup_key в спеке).
  contentHash    String
  fetchedAt      DateTime           @default(now())
  parseStatus    RawItemParseStatus @default(ok)
  source         Source             @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceRun      SourceRun?         @relation(fields: [sourceRunId], references: [id], onDelete: SetNull)
  normalizedItem NormalizedItem?
  contentItem    ContentItem?

  @@unique([sourceId, contentHash])
  @@index([sourceId, externalItemId])
  @@index([sourceId, fetchedAt])
  @@index([sourceRunId])
  @@map("raw_items")
}

model NormalizedItem {
  id                    String           @id @default(cuid())
  rawItemId             String           @unique
  eventType             String?
  discipline            String?
  title                 String?
  descriptionShort      String?          @db.Text
  descriptionFull       String?          @db.Text
  country               String?
  region                String?
  city                  String?
  venue                 String?
  startDate             DateTime?
  endDate               DateTime?
  durationDays          Int?
  level                 String?
  priceFrom             Int?
  currency              String?
  organizerName         String?
  bookingUrl            String?
  imageUrl              String?
  confidenceScore       Float?
  // Релевантность для витрины/конвейера; отдельно от scoring на EventCandidate.
  relevanceScore        Float?
  moderationFlagsJson   Json?
  // Каноническая нормализованная структура; дублирует/дополняет extractedJson по мере внедрения.
  normalizedPayloadJson Json?
  parseVersion          String
  extractedJson         Json?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  rawItem               RawItem          @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  candidates            EventCandidate[]
  contentItem           ContentItem?

  @@index([discipline, startDate])
  @@map("normalized_items")
}

model EventGroup {
  id                   String           @id @default(cuid())
  canonicalCandidateId String?
  groupKey             String           @unique
  mergeStatus          String           @default("open") // open | merged | locked
  metaJson             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  candidates           EventCandidate[]

  @@map("event_groups")
}

model EventCandidate {
  id                   String            @id @default(cuid())
  normalizedItemId     String
  dedupGroupId         String?
  status               String            @default("new") // new | needs_review | approved | rejected | merged | published | archived
  reviewPriority       Int               @default(0)
  trustScore           Float             @default(0)
  fitScore             Float             @default(0)
  futureEventScore     Float             @default(0)
  duplicateScore       Float             @default(0)
  finalScore           Float             @default(0)
  eventLikelihoodScore Float             @default(0)
  completenessScore    Float             @default(0)
  sourceTrustScore     Float             @default(0)
  tourismFitScore      Float             @default(0)
  decisionNotes        String?           @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  normalizedItem       NormalizedItem    @relation(fields: [normalizedItemId], references: [id], onDelete: Cascade)
  dedupGroup           EventGroup?       @relation(fields: [dedupGroupId], references: [id], onDelete: SetNull)
  publishedProgram     PublishedProgram?
  contentItem          ContentItem?

  @@index([status, finalScore])
  @@index([normalizedItemId])
  @@map("event_candidates")
}

model PublishedProgram {
  id            String         @id @default(cuid())
  candidateId   String         @unique
  programId     String         @unique
  publishedAt   DateTime       @default(now())
  publishStatus String // draft_created | internal_review | published | archived
  editorNotes   String?        @db.Text
  candidate     EventCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  program       Program        @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@map("published_programs")
}

model Lead {
  id                        String                       @id @default(cuid())
  programId                 String
  organizerId               String
  source                    String                       @default("mywave")
  /// Публичный токен заявки для deep-link и сверки (Telegram / assisted booking).
  leadToken                 String?                      @unique
  telegramUserId            String?
  sourcePostId              String?
  deeplinkPayload           String?
  // travelerKeyHash: HMAC guest contact, see docs/analytics/runtime/TRAVELER_KEY_POLICY.md
  travelerKeyHash           String?
  guestContact              String                       @db.Text
  sourceChannel             String?
  sourceCampaign            String?
  partnerId                 String?
  firstContactAt            DateTime                     @default(now())
  attributionWindowDays     Int                          @default(60)
  leadStatus                String                       @default("new") // new | contacted | qualified | rejected
  notes                     String?                      @db.Text
  sentToOrganizerAt         DateTime?
  organizerFirstResponseAt  DateTime?
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  program                   Program                      @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer                 Organizer                    @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  telegramUser              TelegramUser?                @relation(fields: [telegramUserId], references: [id], onDelete: SetNull)
  bookings                  Booking[]
  payments                  Payment[]
  refunds                   Refund[]
  commissions               Commission[]
  organizerLeadStatusEvents OrganizerLeadStatusEvent[]
  reconciliationTasks       TelegramReconciliationTask[]

  @@index([organizerId, leadStatus])
  @@index([programId, firstContactAt])
  @@index([travelerKeyHash])
  @@index([telegramUserId])
  @@map("leads")
}

// booking_data_contract.md, canonical_status_models. Booking = canonical business entity.
model Booking {
  id                        String         @id @default(cuid())
  leadId                    String?
  programId                 String
  organizerId               String
  source                    String         @default("mywave")
  // travelerKeyHash: HMAC guest contact, see docs/analytics/runtime/TRAVELER_KEY_POLICY.md
  travelerKeyHash           String?
  guestContact              String         @db.Text // name, phone, email (assisted intake)
  sourceChannel             String? // landing | program_page | referral | tg | ...
  sourceCampaign            String?
  partnerId                 String?
  leadOwner                 String?
  /// Атрибуция контента / explore (G4.1), дублирует читаемые поля (не только sourceCampaign).
  contentItemId             String?
  entryType                 String?
  entryId                   String?
  exploreType               String?
  exploreSlug               String?
  utmSource                 String?
  utmMedium                 String?
  bookingStatus             String // created | booked | paid_partial | paid_full | completed | canceled | refunded_* | disputed (+ legacy statuses)
  attributionWindowDays     Int            @default(60)
  firstResponseAt           DateTime?
  bookedAt                  DateTime?
  completedAt               DateTime?
  cancellationReason        String?        @db.Text
  refundAmountRub           Int?
  paidAmountRub             Int            @default(0)
  refundedAmountRub         Int            @default(0)
  netAmountRub              Int            @default(0)
  gmvRub                    Int? // required for revenue; no negative
  expectedCommissionRub     Int?
  accruedCommissionRub      Int?
  collectedCommissionRub    Int?
  proofOfCompletion         String?        @db.Text
  notes                     String?        @db.Text
  /// Согласие с политикой и передачей контакта (PDP)
  legalConsentAt            DateTime?
  legalConsentPolicyVersion String?
  /// Денорм для Telegram-заявок (связь с Lead.leadToken).
  leadToken                 String?
  telegramUserId            String?
  participantsCount         Int?
  childrenCount             Int?
  riskAcknowledged          Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  lead                      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  telegramUser              TelegramUser?  @relation(fields: [telegramUserId], references: [id], onDelete: SetNull)
  program                   Program        @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer                 Organizer      @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  contentItem               ContentItem?   @relation(fields: [contentItemId], references: [id], onDelete: SetNull)
  deal                      Deal?
  payments                  Payment[]
  refunds                   Refund[]
  reviews                   Review[]
  reviewRequest             ReviewRequest?
  incidents                 Incident[]
  commissions               Commission[]

  @@index([leadId])
  @@index([organizerId, bookingStatus])
  @@index([travelerKeyHash])
  @@index([contentItemId])
  @@map("bookings")
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  leadId            String?
  organizerId       String
  programId         String
  amountRub         Int
  status            String    @default("confirmed") // recorded | confirmed | failed | reversed
  paymentKind       String    @default("full") // partial | full
  paidAt            DateTime  @default(now())
  externalReference String?
  paymentMethod     String?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([bookingId, paidAt])
  @@index([organizerId, paidAt])
  @@map("payments")
}

model Refund {
  id                String    @id @default(cuid())
  bookingId         String
  paymentId         String?
  leadId            String?
  organizerId       String
  programId         String
  amountRub         Int
  status            String    @default("completed") // recorded | completed | failed
  reason            String?   @db.Text
  refundedAt        DateTime  @default(now())
  externalReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([bookingId, refundedAt])
  @@index([organizerId, refundedAt])
  @@map("refunds")
}

model ProgramMedia {
  id        String  @id @default(cuid())
  programId String
  mediaType String // image | video
  url       String
  caption   String?
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_media")
}

// db_schema_draft, verification_framework. Support for verified/trusted organizer.
model OrganizerVerificationEvidence {
  id           String    @id @default(cuid())
  organizerId  String
  evidenceType String // document | media_report | review_batch | ...
  evidenceUrl  String?
  notes        String?   @db.Text
  createdAt    DateTime  @default(now())
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@map("organizer_verification_evidence")
}

// db_schema_draft. Review only after completed booking (canonical rule).
model Review {
  id               String    @id @default(cuid())
  bookingId        String    @unique
  programId        String
  organizerId      String
  rating           Int // 1-5 or scale
  comment          String?   @db.Text
  moderationStatus String    @default("pending") // pending | approved | rejected
  createdAt        DateTime  @default(now())
  booking          Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  program          Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer        Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model ReviewRequest {
  id                 String    @id @default(cuid())
  bookingId          String    @unique
  organizerId        String
  programId          String
  guestContact       String    @db.Text
  status             String    @default("queued") // queued | sent | delivery_failed | skipped_no_contact | skipped_no_email | skipped_staging_allowlist | skipped_review_exists
  requestToken       String    @unique
  requestedAt        DateTime  @default(now())
  firstSentAt        DateTime?
  lastSentAt         DateTime?
  nextReminderAt     DateTime?
  reminderCount      Int       @default(0)
  maxReminders       Int       @default(2)
  lastAttemptAt      DateTime?
  lastError          String?   @db.Text
  bookingCompletedAt DateTime?
  booking            Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organizer          Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program            Program   @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([status, nextReminderAt])
  @@index([organizerId, status])
  @@map("review_requests")
}

// db_schema_draft, canonical_status_models. Incident status: open | triaged | ... | closed
model Incident {
  id             String    @id @default(cuid())
  bookingId      String?
  organizerId    String
  programId      String?
  type           String // complaint | safety | refund | fraud | ...
  severity       String // low | medium | high | critical
  summary        String    @db.Text
  incidentStatus String // open | triaged | investigating | ... | closed
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  booking        Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  organizer      Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program        Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@map("incidents")
}

// commission_data_contract. Commission only after completed deal. Auditable.
model Commission {
  id                     String                 @id @default(cuid())
  bookingId              String
  leadId                 String?
  organizerId            String
  programId              String
  gmvRub                 Int                    @default(0)
  commissionRatePct      Int?
  commissionRateBps      Int                    @default(300)
  commissionBaseRub      Int                    @default(0)
  commissionAmountRub    Int                    @default(0)
  commissionFixedRub     Int?
  commissionAccruedRub   Int?
  commissionCollectedRub Int?
  calculationJson        Json?
  invoiceStatus          String?
  paymentDueDate         DateTime?
  paymentReceivedDate    DateTime?
  accruedAt              DateTime?
  approvedAt             DateTime?
  invoicedAt             DateTime?
  paidAt                 DateTime?
  reversedAt             DateTime?
  reconciliationStatus   String // draft | accrued | approved | invoiced | paid | reversed (+ legacy statuses)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  booking                Booking                @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lead                   Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer              Organizer              @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program                Program                @relation(fields: [programId], references: [id], onDelete: Restrict)
  statementLines         BillingStatementLine[]

  @@unique([bookingId])
  @@index([organizerId, reconciliationStatus])
  @@index([leadId])
