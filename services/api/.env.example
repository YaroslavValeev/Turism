# Копируйте в `.env` рядом с этим файлом. Канонические переменные API runtime (non-prod / Docker-first).
# Дополнительно можно держать общие секреты в корне репозитория `.env` — API подхватит их при старте,
# а значения из `services/api/.env` перекроют корень.

APP_ENV=local
# launch (по умолчанию в коде, если не задано) | monetization
PLATFORM_MODE=launch
DATABASE_URL="postgresql://user:password@localhost:5432/mywave"
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars

# Analytics / internal HTTP (канон)
ANALYTICS_ENABLED=1
INTERNAL_ANALYTICS_TOKEN=change-me-long-random

# Telegram alerts (канон: полный Bot API prefix + chat id)
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org/bot<YOUR_BOT_TOKEN>
TELEGRAM_ALERT_CHAT_ID=123456789

# MAX (мессенджер): каркас доставки подписок каталога — URL/путь/токен подставьте по официальному API MAX
# MAX_MESSENGER_API_BASE_URL=https://example-max-api.example.com
# MAX_MESSENGER_SEND_PATH=/send
# MAX_MESSENGER_ACCESS_TOKEN=

# --- Legacy / root-only имена (подхватываются автоматически, если канон пустой) ---
# TELEGRAM_BOT_TOKEN=<token>
# OWNER_CHAT_ID=123456789
# TARGET_INTERNAL_TOKEN=<same as INTERNAL_ANALYTICS_TOKEN for root scripts>

ANALYTICS_ALERT_COOLDOWN_SECONDS=3600
TRAVELER_KEY_SALT=long-random-server-only-salt-for-booking-lead-hash

# Stage 4.1: строгие зоны commission PATCH (по умолчанию выкл.; см. docs/migration/STAGE4_1_COMMISSION_STRICT_MODE.md)
# COMMISSION_RECONCILIATION_STRICT_MODE=true

# Booking / lead delivery (опционально)
# TELEGRAM_ORGANIZER_CHAT_ID=123456789
# LEADS_TELEGRAM_PRIMARY_ENABLED=0
# BOOKING_FALLBACK_EMAIL=ops@example.com

# Ops scheduler (опционально)
# ANALYTICS_OPS_SCHEDULER_ENABLED=0
# ANALYTICS_OPS_INTERVAL_MS=3600000

# Уведомления (MVP: очередь в PostgreSQL + poller / отдельный worker)
# NOTIFICATIONS_ENABLED=1
# NOTIFICATIONS_SCHEDULER_ENABLED=1
# NOTIFICATIONS_DAILY_HOUR_LOCAL=9
# NOTIFICATIONS_UPCOMING_LEAD_DAYS=14
# NOTIFICATIONS_POLL_MS=30000
# NOTIFICATIONS_RATE_LIMIT_PER_DAY=15
# Анти-flip по датам программы (часы), см. docs/qa/NOTIFICATIONS_MVP.md
# NOTIFICATIONS_ANTI_FLIP_WINDOW_HOURS=48
# NOTIFICATIONS_EMAIL_FROM=MyWave <notifications@your-verified-domain.com>
# Resend: тот же ключ, что для прочих исходящих писем (если используете Resend)
# EMAIL_PROVIDER_KEY=re_xxxx

# Отдельный воркер (если NOTIFICATIONS_POLL_MS=0 в API): pnpm --filter api notifications:worker
# NOTIFICATIONS_WORKER_POLL_MS=5000

# Value-based воронка организатора (метрики по программе → сервисные сообщения; не путать с подписками каталога).
# CONVERSION_FUNNEL_ENABLED=0
# CONVERSION_FUNNEL_SCHEDULER_ENABLED=0
# CONVERSION_FUNNEL_INTERVAL_MS=900000
# Ручной тик: POST /jobs/run-conversion-funnel (admin). Сводка: GET /jobs/conversion-funnel-stats?windowHours=24
# По умолчанию в коде: CONVERSION_ALLOWED_MAX_STAGE=2 (этапы 3+ — только при явном повышении в env).
# Первая фаза rollout: оставить 2 или задать явно CONVERSION_ALLOWED_MAX_STAGE=2
# Этапы 4–5 (монетизация) по умолчанию выкл.: CONVERSION_ENABLE_STAGE4=0, CONVERSION_ENABLE_STAGE5=0
# Не чаще 1 успешного сообщения на организатора за период (часы, все программы):
# CONVERSION_ORGANIZER_MIN_INTERVAL_HOURS=48
# Пороги этапов и задержки — см. packages/config/src/env.ts (CONVERSION_*).
# CONVERSION_DISCUSS_URL=mailto:support@example.com
# Для ссылки отписки в письмах нужен публичный host API:
# NOTIFICATIONS_LINK_BASE_URL=http://localhost:3001

# Owner approval (этапы 3–5): черновик в БД + Telegram TELEGRAM_ALERT_CHAT_ID; webhook callback:
# CONVERSION_TELEGRAM_WEBHOOK_SECRET=<random>  → POST .../public/conversion-funnel/governance/<secret>/telegram
# CONVERSION_OWNER_APPROVAL_TTL_HOURS=48      # информативный срок; автосенда организатору по TTL нет
# CONVERSION_OWNER_DEFER_HOURS=24             # defer → повторное напоминание owner после окна (run-conversion-funnel)
# Алерт в ops Telegram, если есть черновики с ownerNotifyFailed (см. /admin/conversion-drafts). По умолчанию выкл.
# CONVERSION_OWNER_NOTIFY_ALERT_ENABLED=0
# CONVERSION_OWNER_NOTIFY_ALERT_INTERVAL_MS=3600000

# UGC after completed (docs/qa/UGC_AFTER_COMPLETED.md).
# Использует те же секреты и ссылки, что и notifications:
#  - NOTIFICATIONS_TOKEN_SECRET (или JWT_SECRET) для подписи submit-токена
#  - NOTIFICATIONS_SITE_BASE_URL для ссылки на форму /program/:id/ugc?token=...
#  - EMAIL_PROVIDER_KEY / NOTIFICATIONS_EMAIL_FROM для отправки письма-запроса
# NOTIFICATIONS_SITE_BASE_URL=http://localhost:3000

# UGC growth loop: reward + referral (docs/qa/UGC_GROWTH_LOOP.md, UGC_REWARD_HARDENING.md).
# Никаких дополнительных секретов не требуется:
#  - NOTIFICATIONS_SITE_BASE_URL используется для ссылок вида /public/referral/:code
#  - EMAIL_PROVIDER_KEY / NOTIFICATIONS_EMAIL_FROM — для placeholder reward-письма после approved UGC
#
# Экономика reward (UserReward):
# REFERRAL_REWARD_VALUE=5                   # число: 5% или 5000₽ в зависимости от type
# REFERRAL_REWARD_VALUE_TYPE=percent        # percent | amount
# REFERRAL_REWARD_CURRENCY=RUB              # только для amount
#
# Анти-абьюз:
# REFERRAL_MAX_BOOKINGS_PER_DAY=20          # лимит bookings по одному коду за 24 часа
#
# Billing (Model A: discount уменьшает цену пользователя, commission — с final):
# REFERRAL_REWARD_MIN_ORDER_RUB=0           # минимум оригинальной цены для применения скидки
#
# Срок действия выданного reward (дней от выдачи); 0 — без expiresAt при создании.
# Истечение: cron `POST /jobs/run-reward-expiry` (или внешний scheduler).
# REFERRAL_REWARD_VALIDITY_DAYS=365
#
# Email «бонус скоро истечёт» (то же job, шаг до expiry): окно в днях и мин. возраст reward.
# REFERRAL_REWARD_EXPIRY_REMINDER_WINDOW_DAYS=7
# REFERRAL_REWARD_REMINDER_MIN_AGE_DAYS=7
#
# Economics guardrails (reward/referral): выкл. ECON_GUARDRAILS_ENABLED=0
# ECON_GUARDRAILS_ENABLED=1
# ECON_MAX_DISCOUNT_SHARE=25
# ECON_GUARDRAILS_LOOKBACK_DAYS=30
# Короткое окно для early-warning (leading indicators), ≤ long
# ECON_GUARDRAILS_SHORT_LOOKBACK_DAYS=7
# ECON_EARLY_WARNING_ENABLED=1
# ECON_EARLY_WARNING_RATIO_SHORT_VS_LONG_FACTOR=1.5
# ECON_EARLY_WARNING_COMPLETION_SHORT_VS_LONG_FACTOR=0.85
# ECON_EARLY_WARNING_STEP_BPS=1000
# ECON_REFERRAL_EW_ENABLED=1
# ECON_REFERRAL_EW_VELOCITY_DROP_FACTOR=1.5
# ECON_REFERRAL_EW_MIN_BOOKINGS_LONG=3
# ECON_GLOBAL_REWARD_ACTION=reduce
# ECON_GLOBAL_REWARD_REDUCE_BPS=5000
# ECON_MIN_REFERRAL_CONVERSION=2
# ECON_REFERRAL_CODE_MIN_VISITS=20
# ECON_MIN_COMPLETION_RATE=10
# Пороги discount/commission (мягкая подстройка reward, см. guardrails job)
# ECON_PROGRAM_RATIO_SOFT=2
# ECON_PROGRAM_RATIO_HARD=3
# ECON_PROGRAM_RATIO_ZERO=5
# Legacy: ECON_PROGRAM_DISCOUNT_TO_COMMISSION_RATIO подставляется в ZERO, если ZERO не задан
# ECON_REWARD_MULTIPLIER_SOFT_BPS=7000
# ECON_REWARD_MULTIPLIER_HARD_BPS=5000
# ECON_REWARD_MULTIPLIER_RECOVERY_STEP_BPS=1000
# ECON_EXPIRY_HEALTH_RATIO=50
#
# Governance alerts v1 (economics): evaluate + Telegram/email, по умолчанию выключено
# ECON_GOVERNANCE_ALERTS_ENABLED=0
# ECON_GOVERNANCE_SCHEDULER_ENABLED=0
# ECON_GOVERNANCE_EVAL_INTERVAL_MS=21600000
# ECON_GOVERNANCE_CRITICAL_COOLDOWN_MS=21600000
# ECON_GOVERNANCE_DIGEST_HOUR_LOCAL=9
# ECON_GOVERNANCE_ALERT_EMAIL=owner@example.com
# Опасные economics override (indefinite, force_suspend, referral force_low_quality): JWT sub через запятую. Пусто = все админы.
# ECONOMICS_PRIVILEGED_ADMIN_SUBS=admin-user-id-from-jwt-sub

# Ручной ingestion из админки: rate limit (см. POST /sources/:id/run, POST /sources/run)
# INGESTION_MANUAL_RUN_MIN_INTERVAL_MS=30000
# INGESTION_MANUAL_BULK_MIN_INTERVAL_MS=90000
# INGESTION_MANUAL_BULK_MAX_SOURCES=40
