{
  "name": "mywave-travel",
  "private": true,
  "scripts": {
    "dev": "pnpm -w run --parallel dev:api dev:admin",
    "dev:api": "pnpm --filter @mywave/shared-types build && pnpm --filter @mywave/config build && pnpm --filter api dev",
    "dev:admin": "pnpm --filter admin dev",
    "clean:web-cache": "node scripts/clean-web-cache.mjs",
    "dev:web:clean": "pnpm run clean:web-cache && pnpm --filter @mywave/config build && pnpm --filter web dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio",
    "db:seed": "pnpm --filter api db:seed",
    "db:import-sources": "pnpm --filter api exec tsx prisma/import_sources.ts",
    "ingest:import-owner-sources": "pnpm --filter api exec tsx prisma/import_sources.ts prisma/source_imports_owner_2026-04-16.json",
    "ingest:merge-owner-sources-from-xlsx": "pnpm --filter api run db:merge-owner-sources-from-xlsx --",
    "ingest:owner-cycle": "pnpm --filter api exec tsx prisma/run_ingestion_cycle.ts",
    "ingest:owner-sources-only": "pnpm --filter api exec tsx prisma/run_ingestion_owner_batch.ts",
    "ingest:count-owner-sources": "pnpm --filter api exec tsx prisma/count_owner_sources.ts",
    "smoke": "node scripts/smoke.js",
    "smoke:analytics": "pnpm --filter @mywave/config build && node -r ./scripts/preload-repo-env.cjs scripts/smoke_analytics_internal.js",
    "check:analytics-parity": "pnpm --filter @mywave/config build && node scripts/check_analytics_parity.mjs",
    "check:telegram-alerts": "pnpm --filter @mywave/config build && node scripts/check_telegram_alert_delivery.mjs",
    "check:web-analytics-proxy": "pnpm --filter @mywave/config build && node scripts/check_web_analytics_proxy.mjs",
    "sync:web-analytics-env": "pnpm --filter @mywave/config build && node scripts/sync-web-analytics-env.mjs",
    "e2e:checkpoint1": "node scripts/e2e_checkpoint1.js",
    "e2e:checkpoint2": "node scripts/e2e_checkpoint2_commission.js",
    "e2e:fair-success-fee": "node scripts/e2e_fair_success_fee.js",
    "check:booking-status-adr007": "node scripts/check-booking-status-writers.mjs",
    "e2e:admin": "pnpm --filter admin test:e2e"
  },
  "devDependencies": {
    "@mywave/config": "workspace:*",
    "dotenv": "^16.4.5",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
