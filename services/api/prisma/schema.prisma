  @@index([leadToken, createdAt])
  @@index([actorType, createdAt])
  @@map("telegram_platform_action_logs")
}

model BlogPost {
  id                   String       @id @default(cuid())
  contentItemId        String
  contentDraftId       String
  placement            String // blog | landing
  slug                 String
  title                String
  excerpt              String?      @db.Text
  /// Основной текст (аналог "content" в продуктовой схеме)
  body                 String?      @db.Text
  sourceUrl            String?      @db.Text
  status               String       @default("published")
  // --- G2: SEO (редактируемые; fallback на title/excerpt/URL в API) ---
  seoTitle             String?      @db.Text
  seoDescription       String?      @db.Text
  canonicalUrl         String?      @db.Text
  ogImage              String?      @db.Text
  // --- G2: классификация и связи ---
  tags                 String[]     @default([])
  discipline           String?
  region               String?
  country              String?
  relatedProgramIds    String[]     @default([])
  relatedOrganizerIds  String[]     @default([])
  relatedCollectionIds String[]     @default([])
  publishedAt          DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  contentItem          ContentItem  @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentDraft         ContentDraft @relation(fields: [contentDraftId], references: [id], onDelete: Cascade)

  @@unique([contentDraftId, placement])
  @@unique([slug, placement])
  @@index([slug])
  @@index([discipline])
  @@index([region])
  @@map("blog_posts")
}

/// G3: тематические подборки (витринные входы: статьи + программы + организаторы).
model ContentCollection {
  id                  String    @id @default(cuid())
  slug                String    @unique
  title               String
  description         String?   @db.Text
  body                String?   @db.Text
  status              String    @default("draft")
  collectionType      String    @default("manual")
  discipline          String?
  region              String?
  country             String?
  season              String?
  seoTitle            String?   @db.Text
  seoDescription      String?   @db.Text
  canonicalUrl        String?   @db.Text
  ogImage             String?   @db.Text
  tags                String[]  @default([])
  relatedBlogPostIds  String[]  @default([])
  relatedProgramIds   String[]  @default([])
  relatedOrganizerIds String[]  @default([])
  publishedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([discipline])
  @@index([region])
  @@index([season])
  @@map("content_collections")
}
