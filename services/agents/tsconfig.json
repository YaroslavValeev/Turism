{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "analytics/**/*.ts",
    "marketing/**/*.ts",
    "orchestrator/**/*.ts",
    "memory/**/*.ts",
    "shared/**/*.ts"
  ]
}
