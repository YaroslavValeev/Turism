# Replace before running install-tourism.sh.
EXPECTED_HOSTNAME=REPLACE_WITH_TOURISM_HOSTNAME

SOCKS_BRIDGE_BIND_HOST=172.18.0.1
SOCKS_BRIDGE_BIND_PORT=1088
SOCKS_BRIDGE_TARGET_HOST=10.77.0.1
SOCKS_BRIDGE_TARGET_PORT=1080
DOCKER_NETWORK=toutism_default

API_BRIDGE_BIND_HOST=10.77.0.2
API_BRIDGE_BIND_PORT=3002
API_CONTAINER_NAME=toutism-api-1
API_CONTAINER_PORT=3001
# Set this when the container has more than one network.
API_DOCKER_NETWORK=toutism_default
API_HEALTH_PATH=/health
API_WEBHOOK_PATH=/public/telegram/webhook
API_MAX_BODY_BYTES=1048576
API_MAX_RESPONSE_BYTES=1048576
API_MAX_CONNECTIONS=32

BRIDGE_CONNECT_TIMEOUT=10
BRIDGE_IO_TIMEOUT=30
BRIDGE_IDLE_TIMEOUT=300
DOCKER_INSPECT_TIMEOUT=5
DOCKER_IP_CACHE_TTL=5

RELAY_STATUS_URL=http://10.77.0.1:18080/v1/status
WEBHOOK_SOCKS_URL=socks5://172.18.0.1:1088
WEBHOOK_ENV_ROOT=/opt/mywave/tourism
WEBHOOK_ENV_FILES=.env,.env.production,services/api/.env.production
TELEGRAM_API_ORIGIN=https://api.telegram.org
WEBHOOK_HTTP_TIMEOUT=15
HEALTH_TIMEOUT=5
