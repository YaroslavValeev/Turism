// Prisma schema. Source of truth: db_schema_draft.csv, db_relationship_notes.md, audit_log_spec.md
// Sprint 1: users, organizers, audit_logs only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Seed: pnpm --filter api db:seed (creates admin@mywave.local)

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  role         String   // admin | organizer | user (Sprint 1: admin only)
  passwordHash String?  // for admin login only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notificationSubscriptions NotificationSubscription[]
  programUgc                ProgramUgc[]
  referralCodes             ReferralCode[]
  rewards                   UserReward[]
}

/// Согласие на уведомления (email / telegram / max). filters: { discipline?, region?, seasonMonth? }.
/// status: pending_confirmation | active | unsubscribed.
/// identityKey: canonical ключ (channel:recipient:type:filtersHash) для дедупа.
model NotificationSubscription {
  id                 String   @id @default(cuid())
  userId             String?
  contactEmail       String?
  telegramChatId     String?
  maxRecipientId     String?
  channel            String // email | telegram | max
  type               String // seasonal | program_updates
  filters            Json     @default("{}")
  status             String   @default("pending_confirmation")
  identityKey        String   @unique
  confirmationToken  String?  @unique
  confirmationSentAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveries         NotificationDelivery[]

  @@index([status, type])
  @@map("notification_subscriptions")
}

/// Очередь событий уведомлений (без BullMQ на MVP — обработка poller-ом).
model NotificationJob {
  id          String    @id @default(cuid())
  eventType String // program_dates_updated | program_upcoming_start
  payload     Json
  dedupeKey   String    @unique
  status      String    @default("pending") // pending | processing | done | failed
  resultCode  String?   // suppressed_flip | ok | error | ...
  attempts    Int       @default(0)
  lastError   String?   @db.Text
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
  @@map("notification_jobs")
}

/// outcome: delivered | skipped_rate_limited | skipped_duplicate | stale_start_date_skipped | unsubscribed | pending_confirmation | failed
model NotificationDelivery {
  id               String   @id @default(cuid())
  subscriptionId   String?
  jobId            String?
  recipientChannel String
  recipientKey     String
  eventType        String
  dedupeKey        String
  programId        String?
  outcome          String   @default("delivered")
  sentAt           DateTime @default(now())
  subscription     NotificationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  feedbacks        NotificationFeedback[]

  @@index([recipientKey, sentAt])
  @@index([jobId])
  @@map("notification_deliveries")
}

/// Реакция пользователя на уведомление: positive | negative. Одна запись на delivery.
model NotificationFeedback {
  id           String   @id @default(cuid())
  deliveryId   String   @unique
  programId    String?
  feedbackType String   // positive | negative
  createdAt    DateTime @default(now())
  delivery     NotificationDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@map("notification_feedback")
}

model Organizer {
  id                 String    @id @default(cuid())
  displayName        String
  legalStatus        String?   // self-employed / ИП / ООО
  contactEmail       String
  contactPhone       String?
  /// Telegram chat_id для сервисных сообщений организатору (воронка, лиды). Не путать с пользовательскими подписками каталога.
  telegramChatId     String?
  responseScore      Int?      // optional metric
  verificationStatus String    // listed | checked | verified | trusted_by_platform | paused | rejected
  onboardingStatus   String    @default("applied") // applied | under_review | approved | contract_pending | contract_signed | billing_connected | active | limited | suspended
  billingStatus      String    @default("not_connected") // not_connected | billing_connected | suspended
  privilegeStatus    String    @default("limited") // limited | active | suspended
  commissionRateBps  Int       @default(300) // Fair Success Fee default 3%
  certificatesSummary String?   @db.Text
  insuranceSummary    String?   @db.Text
  emergencyPlanSummary String?   @db.Text
  equipmentSummary    String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  programs           Program[]
  leads              Lead[]
  bookings           Booking[]
  verificationEvidence OrganizerVerificationEvidence[]
  incidents          Incident[]
  reviews            Review[]
  commissions        Commission[]
  sources            Source[]   @relation("SourceOrganizer")
  externalChannels   OrganizerExternalChannel[]
  payments           Payment[]
  refunds            Refund[]
  billingProfile     OrganizerBillingProfile?
  contracts          OrganizerContract[]
  billingStatements  BillingStatement[]
  scoreSnapshots     OrganizerScoreSnapshot[]
  reviewRequests     ReviewRequest[]
  ugcEntries         ProgramUgc[]
  ugcRequests        ProgramUgcRequest[]
  programConversionStates ProgramConversionState[]
  conversionDeliveries    ProgramConversionDelivery[]
  conversionMessageDrafts ConversionMessageDraft[]

  @@map("organizers")
}

// program_card_schema.md, db_schema_draft. publish_status: canonical_status_models (Program Publication Status)
model Program {
  id                      String    @id @default(cuid())
  organizerId             String
  title                   String
  discipline              String
  region                  String
  exactLocation           String?
  startDate               DateTime
  endDate                 DateTime
  durationDays            Int
  formatType              String?   // tour | camp | clinic | training | ...
  audienceFit             String?   @db.Text
  levelRequired           String?   // beginner | intermediate | advanced | expert
  riskLevel               String?   // low | medium | high | extreme (safety)
  priceFromRub            Int?
  capacityTotal           Int?
  spotsAvailable          Int?
  isStarred               Boolean   @default(false)
  currency                String?   @default("RUB")
  inclusions              String?   @db.Text
  exclusions              String?   @db.Text
  gearRequirements        String?   @db.Text
  medicalLimitations      String?   @db.Text  // safety
  itineraryDayByDay       String?   @db.Text
  organizerName           String?   // denorm for display
  trustReason             String?   @db.Text
  reviewsSummary          String?   @db.Text
  cancellationRules       String?   @db.Text  // required for publish
  whatHappensAfterBooking String?   @db.Text
  cta                     String?
  /// Что взять с собой (организатор). Дополняет gearRequirements (техника/снаряжение).
  packingListNotes      String?   @db.Text
  accommodationNotes    String?   @db.Text
  transportNotes        String?   @db.Text
  sightsNotes           String?   @db.Text
  planBWeatherNotes      String?   @db.Text
  /// Мягкие подсказки платформы (не заменяют данные организатора).
  platformTravelTips    String?   @db.Text
  // Economics guardrails (reward/referral): мягкая подстройка через multiplier bps; suspended = mult 0.
  economicsRewardSuspended       Boolean   @default(false)
  /// Program-level множитель reward (bps): итог = base × global × program; 10000 = 100%.
  economicsRewardMultiplierBps   Int       @default(10000)
  economicsGuardrailReason       String?   @db.Text
  economicsGuardrailUpdatedAt    DateTime?
  /// Leading indicators (short vs long window); не заменяет guardrails, только мягкий nudge или сброс флага.
  economicsEarlyWarningFlag      Boolean   @default(false)
  economicsEarlyWarningReason      String?   @db.Text
  economicsEarlyWarningAt        DateTime?
  economicsEarlyWarningSnapshot  Json?
  /// Ручной override guardrails: пока активен — job не меняет multiplier; grant/apply берут effective из mode.
  economicsOverrideMode          String?
  economicsOverrideReason        String?   @db.Text
  economicsOverrideUntil         DateTime?
  economicsOverrideUpdatedAt     DateTime?
  // Canonical publish intake: organizer_form | admin_manual | email | telegram | sheets_csv | seed (see docs/INGESTION_POLICY.md)
  intakeSource            String?
  publishStatus           String    // draft | internal_review | needs_fix | approved | published | paused | archived
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  organizer               Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  media                   ProgramMedia[]
  leads                   Lead[]
  bookings                Booking[]
  reviews                 Review[]
  incidents               Incident[]
  commissions             Commission[]
  payments                Payment[]
  refunds                 Refund[]
  publishedPrograms       PublishedProgram[]
  scoreSnapshots          ProgramScoreSnapshot[]
  reviewRequests          ReviewRequest[]
  ugcEntries              ProgramUgc[]
  ugcRequests             ProgramUgcRequest[]
  conversionState         ProgramConversionState?
  conversionDeliveries    ProgramConversionDelivery[]
  conversionMessageDrafts ConversionMessageDraft[]

  @@map("programs")
}

model Source {
  id                   String      @id @default(cuid())
  type                 String      // instagram | telegram | rss | site
  name                 String
  urlOrHandle          String
  discipline           String?
  country              String?
  region               String?
  language             String?
  priority             Int         @default(100)
  trustScore           Float       @default(0.5)
  parserProfile        String?
  fetchIntervalMinutes Int         @default(60)
  isActive             Boolean     @default(true)
  sourceOrigin         String      @default("manual") // manual | organizer_contract_auto | batch_import | legacy
  lifecycleState       String      @default("active") // active | inactive | paused_by_policy | manual_override | archived (ADR-009)
  lastCheckedAt        DateTime?
  lastSuccessAt        DateTime?
  lastErrorAt          DateTime?
  lastErrorSnippet     String?     @db.Text
  nextScheduledAt      DateTime?
  metaJson             Json?
  organizerId          String?
  /// Связь с каналом организатора (contract-auto onboarding); null для synthetic telegram или ручных источников.
  externalChannelId    String?
  importSessionId      String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  organizer            Organizer?  @relation("SourceOrganizer", fields: [organizerId], references: [id], onDelete: SetNull)
  externalChannel      OrganizerExternalChannel? @relation(fields: [externalChannelId], references: [id], onDelete: SetNull)
  importSession        SourceImportSession? @relation(fields: [importSessionId], references: [id], onDelete: SetNull)
  runs                 SourceRun[]
  rawItems             RawItem[]

  @@index([type, isActive])
  @@index([sourceOrigin, isActive])
  @@index([organizerId, sourceOrigin])
  @@index([externalChannelId])
  @@map("sources")
}

model OrganizerExternalChannel {
  id                   String    @id @default(cuid())
  organizerId          String
  type                 String    // telegram | instagram | vk | site | rss | other
  urlOrHandle          String
  parserProfile        String?
  fetchIntervalMinutes Int       @default(1440)
  isActive             Boolean   @default(true)
  sourceOrigin         String    @default("organizer_contract_auto")
  lifecycleState       String    @default("active") // active | inactive | paused_by_policy | manual_override | archived (ADR-009)
  autoPublish          Boolean   @default(false)
  metaJson             Json?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organizer            Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  sources              Source[]

  @@unique([organizerId, type, urlOrHandle])
  @@index([organizerId, isActive])
  @@index([type, isActive])
  @@map("organizer_external_channels")
}

model SourceImportSession {
  id             String   @id @default(cuid())
  status         String   @default("created") // created | dry_run | completed | failed
  sourceFileName String?
  sourceFormat   String   @default("xlsx") // xlsx | csv | json
  sourceOrigin   String   @default("batch_import")
  startedBy      String?
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  dryRun         Boolean  @default(false)
  createdCount   Int      @default(0)
  updatedCount   Int      @default(0)
  skippedCount   Int      @default(0)
  duplicateCount Int      @default(0)
  errorCount     Int      @default(0)
  summaryJson    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  rows           SourceImportRow[]
  sources        Source[]

  @@index([status, startedAt])
  @@map("source_import_sessions")
}

model SourceImportRow {
  id            String   @id @default(cuid())
  sessionId     String
  sheetName     String?
  rowNumber     Int?
  sourceType    String?
  urlOrHandle   String?
  sourceName    String?
  action        String?  // created | updated | skipped | duplicate | manual_review | error
  errorMessage  String?  @db.Text
  sourceId      String?
  normalizedJson Json?
  rawJson       Json?
  createdAt     DateTime @default(now())
  session       SourceImportSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, action])
  @@map("source_import_rows")
}

model SourceRun {
  id           String    @id @default(cuid())
  sourceId     String
  runType      String    @default("collect") // collect | normalize | dedup | publish
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       String    // running | success | partial | failed
  itemsFound   Int       @default(0)
  itemsCreated Int       @default(0)
  errorMessage String?   @db.Text
  metaJson     Json?
  source       Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@map("source_runs")
}

model RawItem {
  id             String          @id @default(cuid())
  sourceId       String
  externalItemId String?
  sourceType     String
  sourceUrl      String?
  authorName     String?
  publishedAt    DateTime?
  rawTitle       String?         @db.Text
  rawText        String?         @db.Text
  rawMediaJson   Json?
  rawPayloadJson Json?
  contentHash    String
  fetchedAt      DateTime        @default(now())
  source         Source          @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  normalizedItem NormalizedItem?

  @@unique([sourceId, externalItemId])
  @@unique([sourceId, contentHash])
  @@index([sourceId, fetchedAt])
  @@map("raw_items")
}

model NormalizedItem {
  id               String           @id @default(cuid())
  rawItemId        String           @unique
  eventType        String?
  discipline       String?
  title            String?
  descriptionShort String?          @db.Text
  descriptionFull  String?          @db.Text
  country          String?
  region           String?
  city             String?
  venue            String?
  startDate        DateTime?
  endDate          DateTime?
  durationDays     Int?
  level            String?
  priceFrom        Int?
  currency         String?
  organizerName    String?
  bookingUrl       String?
  imageUrl         String?
  confidenceScore  Float?
  parseVersion     String
  extractedJson    Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rawItem          RawItem          @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  candidates       EventCandidate[]

  @@index([discipline, startDate])
  @@map("normalized_items")
}

model EventGroup {
  id                   String           @id @default(cuid())
  canonicalCandidateId String?
  groupKey             String           @unique
  mergeStatus          String           @default("open") // open | merged | locked
  metaJson             Json?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  candidates           EventCandidate[]

  @@map("event_groups")
}

model EventCandidate {
  id                   String          @id @default(cuid())
  normalizedItemId     String
  dedupGroupId         String?
  status               String          @default("new") // new | needs_review | approved | rejected | merged | published | archived
  reviewPriority       Int             @default(0)
  trustScore           Float           @default(0)
  fitScore             Float           @default(0)
  futureEventScore     Float           @default(0)
  duplicateScore       Float           @default(0)
  finalScore           Float           @default(0)
  eventLikelihoodScore Float           @default(0)
  completenessScore    Float           @default(0)
  sourceTrustScore     Float           @default(0)
  tourismFitScore      Float           @default(0)
  decisionNotes        String?         @db.Text
  reviewedBy           String?
  reviewedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  normalizedItem       NormalizedItem  @relation(fields: [normalizedItemId], references: [id], onDelete: Cascade)
  dedupGroup           EventGroup?     @relation(fields: [dedupGroupId], references: [id], onDelete: SetNull)
  publishedProgram     PublishedProgram?

  @@index([status, finalScore])
  @@index([normalizedItemId])
  @@map("event_candidates")
}

model PublishedProgram {
  id            String         @id @default(cuid())
  candidateId   String         @unique
  programId     String         @unique
  publishedAt   DateTime       @default(now())
  publishStatus String         // draft_created | internal_review | published | archived
  editorNotes   String?        @db.Text
  candidate     EventCandidate @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  program       Program        @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@map("published_programs")
}

model Lead {
  id                    String    @id @default(cuid())
  programId             String
  organizerId           String
  source                String    @default("mywave")
  // travelerKeyHash: HMAC guest contact, see docs/analytics/runtime/TRAVELER_KEY_POLICY.md
  travelerKeyHash       String?
  guestContact          String    @db.Text
  sourceChannel         String?
  sourceCampaign        String?
  partnerId             String?
  firstContactAt        DateTime  @default(now())
  attributionWindowDays Int       @default(60)
  leadStatus            String    @default("new") // new | contacted | qualified | rejected
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  program               Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer             Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  bookings              Booking[]
  payments              Payment[]
  refunds               Refund[]
  commissions           Commission[]

  @@index([organizerId, leadStatus])
  @@index([programId, firstContactAt])
  @@index([travelerKeyHash])
  @@map("leads")
}

// booking_data_contract.md, canonical_status_models. Booking = canonical business entity.
model Booking {
  id                  String    @id @default(cuid())
  leadId              String?
  programId           String
  organizerId         String
  source              String    @default("mywave")
  // travelerKeyHash: HMAC guest contact, see docs/analytics/runtime/TRAVELER_KEY_POLICY.md
  travelerKeyHash     String?
  guestContact        String    @db.Text  // name, phone, email (assisted intake)
  sourceChannel       String?   // landing | program_page | referral | tg | ...
  sourceCampaign      String?
  partnerId           String?
  leadOwner           String?
  bookingStatus       String    // created | booked | paid_partial | paid_full | completed | canceled | refunded_* | disputed (+ legacy statuses)
  attributionWindowDays Int     @default(60)
  firstResponseAt     DateTime?
  bookedAt            DateTime?
  completedAt         DateTime?
  cancellationReason  String?   @db.Text
  // Классификация отмены (для reward recovery policy):
  // organizer_cancelled | platform_cancelled | user_cancelled | no_show | fraud | other
  cancellationKind    String?
  refundAmountRub     Int?
  paidAmountRub       Int       @default(0)
  refundedAmountRub   Int       @default(0)
  netAmountRub        Int       @default(0)
  // Model A: discount уменьшает цену пользователя; commission считается от finalAmount.
  originalAmountRub   Int?
  discountAmountRub   Int?
  finalAmountRub      Int?
  gmvRub              Int?      // required for revenue; no negative
  expectedCommissionRub  Int?
  accruedCommissionRub   Int?
  collectedCommissionRub Int?
  proofOfCompletion   String?   @db.Text
  notes               String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  lead                Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  program             Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer           Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  payments            Payment[]
  refunds             Refund[]
  reviews             Review[]
  reviewRequest       ReviewRequest?
  incidents           Incident[]
  commissions         Commission[]
  ugc                 ProgramUgc?
  ugcRequest          ProgramUgcRequest?
  referralCode        String?
  referral            ReferralCode? @relation(fields: [referralCode], references: [code], onDelete: SetNull)
  appliedRewardId     String?       @unique
  appliedReward       UserReward?   @relation("BookingAppliedReward", fields: [appliedRewardId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([organizerId, bookingStatus])
  @@index([travelerKeyHash])
  @@index([referralCode])
  @@map("bookings")
}

model Payment {
  id                String    @id @default(cuid())
  bookingId         String
  leadId            String?
  organizerId       String
  programId         String
  amountRub         Int
  status            String    @default("confirmed") // recorded | confirmed | failed | reversed
  paymentKind       String    @default("full") // partial | full
  paidAt            DateTime  @default(now())
  externalReference String?
  paymentMethod     String?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  refunds           Refund[]

  @@index([bookingId, paidAt])
  @@index([organizerId, paidAt])
  @@map("payments")
}

model Refund {
  id                String    @id @default(cuid())
  bookingId         String
  paymentId         String?
  leadId            String?
  organizerId       String
  programId         String
  amountRub         Int
  status            String    @default("completed") // recorded | completed | failed
  reason            String?   @db.Text
  refundedAt        DateTime  @default(now())
  externalReference String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment           Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  lead              Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([bookingId, refundedAt])
  @@index([organizerId, refundedAt])
  @@map("refunds")
}

model ProgramMedia {
  id         String  @id @default(cuid())
  programId String
  mediaType  String  // image | video
  url        String
  caption    String?
  program    Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_media")
}

// db_schema_draft, verification_framework. Support for verified/trusted organizer.
model OrganizerVerificationEvidence {
  id          String   @id @default(cuid())
  organizerId String
  evidenceType String  // document | media_report | review_batch | ...
  evidenceUrl  String?
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  organizer    Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@map("organizer_verification_evidence")
}

// db_schema_draft. Review only after completed booking (canonical rule).
model Review {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  programId       String
  organizerId     String
  rating          Int      // 1-5 or scale
  comment         String?  @db.Text
  moderationStatus String  @default("pending") // pending | approved | rejected
  createdAt       DateTime @default(now())
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  program         Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer       Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)

  @@map("reviews")
}

model ReviewRequest {
  id                String   @id @default(cuid())
  bookingId         String   @unique
  organizerId       String
  programId         String
  guestContact      String   @db.Text
  status            String   @default("queued") // queued | sent | delivery_failed | skipped_no_contact | skipped_review_exists
  requestToken      String   @unique
  requestedAt       DateTime @default(now())
  firstSentAt       DateTime?
  lastSentAt        DateTime?
  nextReminderAt    DateTime?
  reminderCount     Int      @default(0)
  maxReminders      Int      @default(2)
  lastAttemptAt     DateTime?
  lastError         String?  @db.Text
  bookingCompletedAt DateTime?
  booking           Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program           Program   @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([status, nextReminderAt])
  @@index([organizerId, status])
  @@map("review_requests")
}

/// UGC-запрос: письмо после completed booking с CTA оставить отзыв и медиа.
/// Статусы: queued | sent | delivery_failed | skipped_no_email | submitted.
model ProgramUgcRequest {
  id                 String   @id @default(cuid())
  bookingId          String   @unique
  programId          String
  organizerId        String
  recipientEmail     String?
  status             String   @default("queued")
  requestToken       String   @unique
  requestedAt        DateTime @default(now())
  firstSentAt        DateTime?
  lastSentAt         DateTime?
  lastAttemptAt      DateTime?
  lastError          String?  @db.Text
  bookingCompletedAt DateTime?
  submittedUgcId     String?
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  program            Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer          Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  submittedUgc       ProgramUgc? @relation(fields: [submittedUgcId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([programId])
  @@map("program_ugc_requests")
}

/// UGC после completed booking. Публикуется только после moderation = approved.
/// source: post_trip_request | manual.
/// rewardStatus: none | pending | granted (MVP placeholder reward, без кошелька).
model ProgramUgc {
  id               String   @id @default(cuid())
  programId        String
  organizerId      String
  bookingId        String   @unique
  userId           String?
  authorName       String
  contactEmail     String?
  textReview       String   @db.Text
  rating           Int?
  mediaUrls        Json     @default("[]")
  consentToPublish Boolean  @default(false)
  moderationStatus String   @default("pending") // pending | approved | rejected
  moderationNotes  String?  @db.Text
  source           String   @default("post_trip_request")
  rewardStatus     String   @default("none") // none | pending | granted
  rewardGrantedAt  DateTime?
  referralCode     String?  @unique
  createdAt        DateTime @default(now())
  reviewedAt       DateTime?
  program          Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  organizer        Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  booking          Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  requests         ProgramUgcRequest[]
  ownedReferral    ReferralCode?
  mediaAssets      ProgramUgcMediaAsset[]

  @@index([programId, moderationStatus])
  @@index([moderationStatus, createdAt])
  @@map("program_ugc")
}

/// Нативные медиафайлы UGC (S3-compatible key); модерация human-gate (Wave 3).
model ProgramUgcMediaAsset {
  id                 String    @id @default(cuid())
  programUgcId       String
  storageKey         String
  mimeType           String
  byteSize           Int       @default(0)
  moderationStatus   String    @default("pending") // pending | approved | rejected
  moderationNotes  String?   @db.Text
  createdAt          DateTime  @default(now())
  programUgc         ProgramUgc @relation(fields: [programUgcId], references: [id], onDelete: Cascade)

  @@index([programUgcId])
  @@index([moderationStatus, createdAt])
  @@map("program_ugc_media_assets")
}

/// Reward пользователя: MVP percent или fixed amount, статус available|used|expired.
/// source=ugc + sourceRefId=<program_ugc.id>. Выдаётся при approve+grant.
model UserReward {
  id            String   @id @default(cuid())
  userId        String?
  email         String?
  source        String   @default("ugc")
  sourceRefId   String?
  valueType     String   @default("percent") // percent | amount
  value         Int
  currency      String?
  status        String   @default("available") // available | used | expired
  usedBookingId String?
  createdAt     DateTime @default(now())
  usedAt        DateTime?
  expiresAt     DateTime?
  /// Единоразовое email-напоминание «скоро истечёт» (job до основного expiry).
  expiryReminderSentAt DateTime?
  // Reward recovery lifecycle: если reward был used и возвращён в available,
  // фиксируем момент и причину для админской видимости и audit.
  recoveredAt              DateTime?
  recoveredCancellationKind String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  appliedOnBooking Booking? @relation("BookingAppliedReward")

  @@index([userId, status])
  @@index([email, status])
  @@index([source, sourceRefId])
  @@index([status, expiresAt])
  @@map("user_rewards")
}

/// Журнал отказов по referral-коду: self_use_blocked, duplicate_use_blocked, rate_limited.
/// Не связан foreign key с кодом — код может быть удалён, журнал остаётся для аналитики.
model ReferralAbuseEvent {
  id        String   @id @default(cuid())
  code      String?
  reason    String
  email     String?
  userId    String?
  programId String?
  bookingId String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([reason, createdAt])
  @@index([code])
  @@map("referral_abuse_events")
}

/// Referral-код. Генерируется при grant reward для approved UGC.
/// MVP: ownerUgcId + ownerEmail/ownerUserId; без cash, без multi-level.
model ReferralCode {
  code         String   @id
  ownerUserId  String?
  ownerEmail   String?
  ownerUgcId   String?  @unique
  visits       Int      @default(0)
  bookings     Int      @default(0)
  lastVisitAt  DateTime?
  createdAt    DateTime @default(now())
  /// Economics: низкая конверсия visit→booking относительно порога (см. guardrails job).
  economicsLowQuality     Boolean   @default(false)
  economicsLowQualityReason String?   @db.Text
  economicsLowQualityAt     DateTime?
  /// Short vs long conversion/velocity (leading); multiplier программы не трогаем — только флаг + audit.
  economicsEarlyWarningFlag      Boolean   @default(false)
  economicsEarlyWarningReason    String?   @db.Text
  economicsEarlyWarningAt        DateTime?
  economicsEarlyWarningSnapshot  Json?
  /// Ручной override: пока активен — job не меняет low_quality / EW по авто-логике.
  economicsOverrideMode          String?
  economicsOverrideReason        String?   @db.Text
  economicsOverrideUntil         DateTime?
  economicsOverrideUpdatedAt     DateTime?
  ownerUser    User?    @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  ownerUgc     ProgramUgc? @relation(fields: [ownerUgcId], references: [id], onDelete: SetNull)
  attributedBookings Booking[]

  @@index([ownerEmail])
  @@index([ownerUserId])
  @@index([economicsLowQuality])
  @@map("referral_codes")
}

// db_schema_draft, canonical_status_models. Incident status: open | triaged | ... | closed
model Incident {
  id            String   @id @default(cuid())
  bookingId     String?
  organizerId   String
  programId     String?
  type          String   // complaint | safety | refund | fraud | ...
  severity      String   // low | medium | high | critical
  summary       String   @db.Text
  incidentStatus String  // open | triaged | investigating | ... | closed
  /// Опциональная связь с governance_alerts (корреляция с алертом, не дублирование сущности).
  governanceAlertId String?
  /// SLA / дедлайн реакции (ops), опционально.
  slaDueAt      DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  booking       Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  organizer     Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program       Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)
  governanceAlert GovernanceAlert? @relation(fields: [governanceAlertId], references: [id], onDelete: SetNull)

  @@index([governanceAlertId])
  @@map("incidents")
}

// commission_data_contract. Commission only after completed deal. Auditable.
model Commission {
  id                    String   @id @default(cuid())
  bookingId             String
  leadId                String?
  organizerId           String
  programId             String
  gmvRub                Int      @default(0)
  commissionRatePct     Int?
  commissionRateBps     Int      @default(300)
  commissionBaseRub     Int      @default(0)
  commissionAmountRub   Int      @default(0)
  commissionFixedRub    Int?
  commissionAccruedRub  Int?
  commissionCollectedRub Int?
  calculationJson       Json?
  invoiceStatus         String?
  paymentDueDate        DateTime?
  paymentReceivedDate   DateTime?
  accruedAt             DateTime?
  approvedAt            DateTime?
  invoicedAt            DateTime?
  paidAt                DateTime?
  reversedAt            DateTime?
  reconciliationStatus String   // draft | accrued | approved | invoiced | paid | reversed (+ legacy statuses)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lead                  Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  organizer             Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  program               Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  statementLines        BillingStatementLine[]

  @@unique([bookingId])
  @@index([organizerId, reconciliationStatus])
  @@index([leadId])
  @@map("commissions")
}

model OrganizerBillingProfile {
  id                   String    @id @default(cuid())
  organizerId          String    @unique
  legalType            String?
  legalName            String?
  inn                  String?
  bankName             String?
  bankBik              String?
  bankAccount          String?
  correspondentAccount String?
  contactEmail         String?
  contactPhone         String?
  cancellationPolicy   String?   @db.Text
  refundPolicy         String?   @db.Text
  commissionRateBps    Int       @default(300)
  billingStatus        String    @default("not_connected") // not_connected | billing_connected | suspended
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  organizer            Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@map("organizer_billing_profiles")
}

model OrganizerContract {
  id          String    @id @default(cuid())
  organizerId String
  status      String    @default("not_generated") // not_generated | generated | sent | signed | expired | rejected
  documentUrl String?
  generatedAt DateTime?
  sentAt      DateTime?
  signedAt    DateTime?
  expiresAt   DateTime?
  rejectedAt  DateTime?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, status])
  @@map("organizer_contracts")
}

model BillingStatement {
  id                 String    @id @default(cuid())
  organizerId        String
  periodStart        DateTime
  periodEnd          DateTime
  status             String    @default("draft") // draft | review | invoiced | paid | disputed | void
  grossPaidRub       Int       @default(0)
  refundedRub        Int       @default(0)
  netSalesRub        Int       @default(0)
  commissionTotalRub Int       @default(0)
  objectionDeadline  DateTime?
  issuedAt           DateTime?
  paidAt             DateTime?
  notes              String?   @db.Text
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  organizer          Organizer @relation(fields: [organizerId], references: [id], onDelete: Restrict)
  lines              BillingStatementLine[]

  @@index([organizerId, periodStart, periodEnd])
  @@index([status])
  @@map("billing_statements")
}

model BillingStatementLine {
  id                String           @id @default(cuid())
  statementId       String
  commissionId      String
  bookingId         String
  paidAmountRub     Int              @default(0)
  refundedAmountRub Int              @default(0)
  netAmountRub      Int              @default(0)
  commissionRateBps Int              @default(300)
  commissionAmountRub Int            @default(0)
  createdAt         DateTime         @default(now())
  statement         BillingStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  commission        Commission       @relation(fields: [commissionId], references: [id], onDelete: Restrict)

  @@index([statementId])
  @@index([commissionId])
  @@index([bookingId])
  @@map("billing_statement_lines")
}

// audit_log_spec.md. Depth: actor=changedBy, entity_type, entity_id, action=changedField, timestamp=createdAt, metadata/diff=oldValue,newValue
model AuditLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  changedField String   // action (e.g. verification_status_change, publish_status_change)
  oldValue     String?  // diff
  newValue     String?  // diff
  changedBy    String?  // actor
  reason       String?
  createdAt    DateTime @default(now()) // timestamp

  @@map("audit_logs")
}

/// Governance / economics alerting v1: дедуп по fingerprint, доставка с cooldown.
model GovernanceAlert {
  id           String    @id @default(cuid())
  fingerprint  String    @unique
  alertType    String
  severity     String // info | warning | critical
  entityType   String
  entityId     String
  title        String
  detail       String?   @db.Text
  payloadJson  Json?
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  lastSentAt   DateTime?
  lastDigestAt DateTime?
  status       String    @default("open") // open | muted | resolved
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  incidents    Incident[]

  @@index([status, severity, lastSeenAt])
  @@index([severity, status])
  @@map("governance_alerts")
}

/// Одна строка: время последнего daily digest.
model GovernanceDigestState {
  id               String    @id @default("default")
  lastDigestSentAt DateTime?
  updatedAt        DateTime  @updatedAt

  @@map("governance_digest_state")
}

/// Операционные статусные события (не analytics telemetry). Источник правды для таймлайна и интеграций.
model DomainStatusEvent {
  id              String   @id @default(cuid())
  eventType       String
  entityType      String
  entityId        String
  fromStatus      String?
  toStatus        String?
  triggerMode     String   // manual | auto
  actorId         String?
  actorMarker     String?
  reason          String?  @db.Text
  source          String?
  payloadJson     Json?
  idempotencyKey  String?  @unique
  occurredAt      DateTime @default(now())

  @@index([entityType, entityId, occurredAt])
  @@index([occurredAt])
  @@map("domain_status_events")
}

// Публичные заявки с лендинга (пилот): без авторизации, обработка оператором вручную.
model PublicOrganizerIntake {
  id             String   @id @default(cuid())
  intakeType     String   // program_submission | verification_inquiry
  contactName    String
  contactEmail   String
  contactPhone   String?
  organization   String?
  programTitle   String?
  discipline     String?
  region         String?
  plannedDates   String?
  message        String?  @db.Text
  links          String?  @db.Text
  meta           Json?
  /// new | in_review | draft_created | dismissed
  processingStatus String  @default("new")
  linkedProgramId  String?
  processedAt      DateTime?
  processedBy      String?
  createdAt      DateTime @default(now())

  @@index([processingStatus, createdAt])
  @@map("public_organizer_intakes")
}

// Analytics event store (non-PII). Source: docs/analytics/*
model AnalyticsEvent {
  id               String   @id @default(cuid())
  eventName        String
  eventVersion     Int      @default(1)
  eventSource      String // frontend | backend | system
  eventTime        DateTime
  ingestedAt       DateTime @default(now())
  idempotencyKey   String   @unique

  traceId          String?
  sessionId        String?
  userIdHash       String?
  userRole         String?
  pageType         String?

  programId        String?
  organizerId      String?
  discipline       String?
  region           String?
  verifiedStatus   String?
  trafficSource    String?

  leadId           String?
  bookingId        String?
  statementId      String?
  paymentId         String?
  refundId          String?
  commissionId      String?

  contractVersion  String?
  paymentStatus    String?

  grossAmount      Int?
  netAmount        Int?
  refundAmount     Int?
  commissionRate   Int?
  commissionAmount Int?

  propertiesJson   Json?
  schemaValid      Boolean  @default(true)
  piiFlag          Boolean  @default(false)

  @@index([eventTime])
  @@index([eventName, eventTime])
  @@index([organizerId, eventTime])
  @@index([bookingId, eventTime])
  @@index([programId, ingestedAt])
  @@map("analytics_events")
}

/// Состояние value-based воронки для организатора по программе (отдельно от notification_subscriptions пользователей каталога).
model ProgramConversionState {
  id                String    @id @default(cuid())
  programId         String    @unique
  organizerId       String
  firstPublishedAt  DateTime
  serviceCommsOptIn Boolean   @default(true)
  maxStageReached   Int       @default(-1)
  stage0SentAt      DateTime?
  stage1SentAt      DateTime?
  stage2SentAt      DateTime?
  stage3SentAt      DateTime?
  stage4SentAt      DateTime?
  stage5SentAt      DateTime?
  /// Когда можно отправить этап 4 (после этапа 3 + задержка).
  stage4EligibleAt  DateTime?
  followUpDueAt     DateTime?
  followUpSentAt    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  program           Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  organizer         Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId])
  @@map("program_conversion_states")
}

model ProgramConversionDelivery {
  id          String    @id @default(cuid())
  programId   String
  organizerId String
  stage       Int
  channel     String
  dedupeKey   String    @unique
  outcome     String
  sentAt      DateTime  @default(now())
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([organizerId, sentAt])
  @@map("program_conversion_deliveries")
}

/// Черновик сообщения организатору по conversion funnel; этапы 3–5 — только после owner approval.
model ConversionMessageDraft {
  id                  String    @id @default(cuid())
  organizerId         String
  programId           String
  stage               Int
  metricsSnapshotJson Json
  /// Планируемый канал к организатору: telegram | email
  channel             String
  messageText         String    @db.Text
  /// draft | awaiting_owner | approved | sent | rejected | deferred | edited
  status              String
  dedupeKey           String    @unique
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?
  reviewedBy          String?
  deferredUntil       DateTime?
  sentAt              DateTime?
  /// Окно для решения owner (информационно; автосенда по истечении нет).
  expiresAt           DateTime?
  /// Успешная доставка уведомления owner в Telegram (не плодим повторы при каждом тике).
  ownerNotifiedAt     DateTime?
  /// Последняя попытка отправить owner уведомление (успех или ошибка).
  ownerNotifyLastAttemptAt DateTime?
  /// Обрезанная причина ошибки Telegram; null если последняя попытка успешна.
  ownerNotifyLastError     String?  @db.VarChar(512)
  organizer           Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  program             Program   @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([status, deferredUntil])
  @@index([organizerId, status])
  @@map("conversion_message_drafts")
}

model AnalyticsEventError {
  id             String   @id @default(cuid())
  idempotencyKey String?
  eventName      String?
  reasonCode     String
  message        String   @db.Text
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([createdAt])
  @@index([reasonCode])
  @@map("analytics_event_errors")
}

model AnalyticsAlertState {
  alertKey        String   @id
  lastFiredAt     DateTime @default(now())
  lastFingerprint String?

  @@map("analytics_alert_state")
}

model AnalyticsMartRefreshLog {
  id         String   @id @default(cuid())
  status     String // success | failure
  message    String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("analytics_mart_refresh_logs")
}

model OrganizerScoreSnapshot {
  id               String    @id @default(cuid())
  organizerId      String
  periodStart      DateTime
  periodEnd        DateTime
  organizerScore   Float
  scoreBand        String // low | medium | high | unknown
  componentsJson   Json
  sampleBookings   Int       @default(0)
  recalculatedAt   DateTime  @default(now())
  organizer        Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([organizerId, periodEnd])
  @@index([recalculatedAt])
  @@map("organizer_score_snapshots")
}

model ProgramScoreSnapshot {
  id                      String   @id @default(cuid())
  programId               String
  periodStart             DateTime
  periodEnd               DateTime
  programContentScore     Float?
  programPerformanceScore Float?
  totalProgramScore       Float
  scoreBand               String // low | medium | high | unknown | insufficient_data
  componentsJson          Json
  sampleViews             Int      @default(0)
  recalculatedAt          DateTime @default(now())
  program                 Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, periodEnd])
  @@index([recalculatedAt])
  @@map("program_score_snapshots")
}
