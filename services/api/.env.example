# Копируйте в `.env` рядом с этим файлом. Канонические переменные API runtime (non-prod / Docker-first).
# Дополнительно можно держать общие секреты в корне репозитория `.env` — API подхватит их при старте,
# а значения из `services/api/.env` перекроют корень.

APP_ENV=local
DATABASE_URL="postgresql://user:password@localhost:5432/mywave"
JWT_SECRET=your-jwt-secret-min-32-chars
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars

# Пилот: бесплатный период для орг., без ведения реальных инвойсов; GET /metrics/pilot-kpi
# PILOT_MODE_ENABLED=1
# Версия политики для legalConsent (POST /bookings, поля legalConsentAt в БД)
# LEGAL_CONSENT_POLICY_VERSION=pilot-v1
# Демо-каталог: 5 орг. × 3 опубликованные программы (только non-production, см. seed.ts)
# SEED_DEMO_CATALOG=1

# Письма «оставьте отзыв» после completed: SMTP + PUBLIC_WEB_BASE_URL обязательны; см. POST /jobs/run-review-reminders
# При EMAIL_STAGING_ALLOWLIST письма уходят только на адреса из списка (как у рассылок по программам).
# REVIEW_REQUEST_EMAIL_DISABLED=1 — не слать письма, только обновлять статусы очереди (отладка).

# Analytics / internal HTTP (канон)
ANALYTICS_ENABLED=1
INTERNAL_ANALYTICS_TOKEN=change-me-long-random
# Private Camp API для MyWave Site: GET /api/v1/camps, /api/v1/camps/:id, /camps-feed.json
CAMP_API_TOKEN=change-me-long-random-camp-feed-token

# Telegram Bot API и единый webhook ingress
# Справка по прод-ID: docs/reference/TELEGRAM_MYWAVETOUR.md
# Канал обновлений (пример): TELEGRAM_UPDATES_CHANNEL_CHAT_ID=-1003491522243
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_API_BASE_URL=https://api.telegram.org/bot<YOUR_BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALERT_CHAT_ID=123456789
TELEGRAM_CHANNEL_CHAT_ID=123456789
TELEGRAM_UPDATES_INVITE_LINK=https://t.me/+yourInviteHash
TELEGRAM_UPDATES_BOT_USERNAME=MyWave_AI_Team_Bot
TELEGRAM_UPDATES_CHANNEL_CHAT_ID=@mywave_updates
# Quality filter for Telegram publish (anti-clickbait / anti-noise)
# TG_TITLE_QUALITY_FILTER_ENABLED=1
# TG_TITLE_MAX_LEN=120
# TG_TITLE_MAX_UPPER_RATIO_PCT=42
# TG_TITLE_ALLOW_PROMO_EMOJI=0
# TG_TITLE_ALLOW_CLICKBAIT=0
# В production укажите публичные домены (API не стартует при APP_ENV=production + localhost в PUBLIC_*).
# Каноничные публичные URL (письма, отписка, Telegram). Локально — http://localhost; prod — https://
PUBLIC_WEB_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:3001
# Staging/QA: только эти email получают письмо о новой программе; публикация в TG-канал при этом пропускается.
# EMAIL_STAGING_ALLOWLIST=you@gmail.com
# Аварийный override, если в prod по ошибке остался localhost (не для реального public prod):
# ALLOW_LOCALHOST_IN_PUBLIC_URLS=0
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=80

# Email (Gmail: пароль приложения, не обычный пароль; см. docs/SPRINT3_SMTP_AND_PUBLIC_URLS.md)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mywavemoscow@gmail.com
SMTP_PASS=app-password-16-chars
SMTP_FROM=MyWaveTour <mywavemoscow@gmail.com>
SMTP_SECURE=1
# Альтернатива: порт 587, SMTP_SECURE=0 (STARTTLS)

# --- Legacy / root-only имена (подхватываются автоматически, если канон пустой) ---
# TELEGRAM_BOT_TOKEN=<token>
# OWNER_CHAT_ID=123456789
# TARGET_INTERNAL_TOKEN=<same as INTERNAL_ANALYTICS_TOKEN for root scripts>

ANALYTICS_ALERT_COOLDOWN_SECONDS=3600
TRAVELER_KEY_SALT=long-random-server-only-salt-for-booking-lead-hash

# Ops scheduler (опционально)
# ANALYTICS_OPS_SCHEDULER_ENABLED=0
# ANALYTICS_OPS_INTERVAL_MS=3600000

# PR2: backfill Source.externalChannelId из metaJson.channelId (только с mode=apply)
# SOURCES_LINKAGE_BACKFILL_WRITE_ENABLED=1

# Internal: POST /internal/content-pipeline/create-from-marketing (тот же токен, что и analytics)
# (INTERNAL_ANALYTICS_TOKEN см. выше)

# Outreach писем организаторам (после free period, без auto-send)
# ORGANIZER_OUTREACH_MIN_FREE_DAYS=60
# ORGANIZER_OUTREACH_METRICS_DAYS=30
# AI: POST /api/organizer-outreach/campaigns/:id/ai-suggest-body
# OPENAI_API_KEY=
# RU VPS egress: proxy URLs belong only in env/secret manager.
# OPENAI_HTTP_PROXY=socks5://172.18.0.1:1088
# TELEGRAM_BOT_HTTP_PROXY=socks5://172.18.0.1:1088
# Пилот: admin-only /ai-pilot/* (нормализатор, safety, card auditor, founder summary). Без 1 + ключа — fallback без падения.
# AI_ENABLED=0
# AI_OWNER_APPROVAL_REQUIRED=1
# AI_AUTOPUBLISH_ENABLED=0

# --- Timeweb / production guardrails (чеклист: docs/deployment/SOURCE_INVENTORY_2026-05-06.md) ---
# APP_ENV=production
# PILOT_MODE_ENABLED=1
# LEGAL_CONSENT_POLICY_VERSION=pilot-v1
# SEED_DEMO_CATALOG=0
# AI_ENABLED=1
# AI_OWNER_APPROVAL_REQUIRED=1
# AI_AUTOPUBLISH_ENABLED=0
# INGESTION_AUTOPUBLISH_ENABLED=0
# Важно: по умолчанию в коде INGESTION_AUTOPUBLISH_ENABLED=true — в проде задайте явно 0, если политика «без автопаблиша».
# PAYMENTS_ENABLED / INVOICES_ENABLED / env COMMISSION_RATE — не читаются loadEnv(); ставка комиссии: Organizer.commissionRateBps в БД (см. billing.ts).
