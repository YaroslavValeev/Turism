[Unit]
Description=MyWave Tourism SOCKS5 TCP bridge to EU
After=network-online.target wg-quick@wg0.service docker.service
Wants=network-online.target wg-quick@wg0.service docker.service

[Service]
Type=simple
User=mywave-relay
Group=mywave-relay
EnvironmentFile=/etc/mywave-tourism/tourism.env
ExecStart=/usr/bin/python3 /usr/local/libexec/mywave-tourism/tourism/tcp_bridge.py --bind-host=${SOCKS_BRIDGE_BIND_HOST} --bind-port=${SOCKS_BRIDGE_BIND_PORT} --target-host=${SOCKS_BRIDGE_TARGET_HOST} --target-port=${SOCKS_BRIDGE_TARGET_PORT} --connect-timeout=${BRIDGE_CONNECT_TIMEOUT} --io-timeout=${BRIDGE_IO_TIMEOUT} --idle-timeout=${BRIDGE_IDLE_TIMEOUT}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
