# Скопируйте в `apps/web/.env.local` (не коммитится).
# Next подхватывает только файлы из каталога apps/web — корневой `.env` и `services/api/.env` сюда не подмешиваются.

# Публичный URL API для клиентских страниц (браузер). Локально — порт API.
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Баннер «пилот» (должно совпадать с согласованной стратегией; в prod обычно 0)
# NEXT_PUBLIC_PILOT_MODE=1
#
# Production (nginx: тот же host + `/api/` → backend): удобно
#   NEXT_PUBLIC_API_URL=/api
#   NEXT_PUBLIC_SITE_URL=https://mywavetour.ru
# Для RSC в Docker обязательно задайте (или в коде fallback на http://api:3001):
#   API_INTERNAL_BASE_URL=http://api:3001
# Если при сборке web в образ попал localhost, код подставит same-origin `/api` на публичном домене (см. getPublicApiBase).

# --- Analytics proxy (серверный route `app/api/analytics/events`) ---
# Должен совпадать с INTERNAL_ANALYTICS_TOKEN в services/api/.env
INTERNAL_ANALYTICS_TOKEN=change-me-same-as-api-internal-token
# Предпочтительно явный внутренний base URL (Docker / compose hostnames)
API_INTERNAL_BASE_URL=http://localhost:3001
# Если API_INTERNAL_BASE_URL не задан, используется NEXT_PUBLIC_API_URL

# Опционально: то же имя, что в корневом .env для скриптов (алиас к INTERNAL_*)
# TARGET_INTERNAL_TOKEN=change-me-same-as-api-internal-token

# Опционально: внешняя аналитика (клиент)
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXX
# NEXT_PUBLIC_YM_ID=00000000
