/// Сквозной идентификатор контент-конвейера (аналог content_item_id в ТЗ). Связывает raw → normalized → candidate → черновики → публикации.
model ContentItem {
  id                         String                @id @default(cuid())
  /// Один content item на одну сырую запись ingestion.
  rawItemId                  String                @unique
  normalizedItemId           String?               @unique
  eventCandidateId           String?               @unique
  // Связь с опубликованной в каталоге программой, если применимо.
  programId                  String?
  workflowStatus             ContentWorkflowStatus @default(ingest_collected)
  lastError                  String?               @db.Text
  idempotencyKey             String?               @unique
  /// Draft, по которому ждём текст/голос owner после «Rewrite».
  ownerReviewAwaitingDraftId String?               @unique
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  rawItem                    RawItem               @relation(fields: [rawItemId], references: [id], onDelete: Cascade)
  normalizedItem             NormalizedItem?       @relation(fields: [normalizedItemId], references: [id], onDelete: SetNull)
  eventCandidate             EventCandidate?       @relation(fields: [eventCandidateId], references: [id], onDelete: SetNull)
  program                    Program?              @relation(fields: [programId], references: [id], onDelete: SetNull)
  ownerReviewAwaitingDraft   ContentDraft?         @relation("OwnerReviewAwaiting", fields: [ownerReviewAwaitingDraftId], references: [id], onDelete: SetNull)
  drafts                     ContentDraft[]
  approvals                  ContentApproval[]
  publications               ContentPublication[]
  metrics                    ContentMetric[]
  blogPosts                  BlogPost[]
  bookings                   Booking[]
  deals                      Deal[]

  @@index([workflowStatus, updatedAt])
  @@map("content_items")
}

model ContentDraft {
  id                       String               @id @default(cuid())
  contentItemId            String
  draftType                ContentDraftType
  /// Целевые каналы (JSON: массив enum-значений ContentPublicationChannel).
  channelTargetsJson       Json?
  generatedHeadline        String?              @db.Text
  shortCopy                String?              @db.Text
  longCopy                 String?              @db.Text
  cta                      String?              @db.Text
  ownerNotes               String?              @db.Text
  voiceTranscript          String?              @db.Text
  aiModel                  String?
  aiPromptVersion          String?
  inputPayloadJson         Json?
  rawDraftText             String?              @db.Text
  finalDraftText           String?              @db.Text
  version                  Int                  @default(1)
  status                   ContentDraftStatus   @default(draft)
  /// Сообщение с превью в Telegram (owner)
  telegramPreviewMessageId Int?
  telegramPreviewChatId    String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  contentItem              ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentItemAwaitingInput ContentItem?         @relation("OwnerReviewAwaiting")
  approvals                ContentApproval[]
  publications             ContentPublication[]
  blogPosts                BlogPost[]

  @@unique([contentItemId, draftType, version])
  @@index([contentItemId, status])
  @@map("content_drafts")
}

model ContentApproval {
  id               String               @id @default(cuid())
  contentItemId    String
  contentDraftId   String?
  decision         ContentOwnerDecision @default(pending)
  comment          String?              @db.Text
  // Решение owner: Telegram / админ (строка user id или username).
  decidedBy        String?
  // telegram | admin | system
  source           String?              @default("telegram")
  ownerVoiceFileId String?
  decidedAt        DateTime?
  createdAt        DateTime             @default(now())
  contentItem      ContentItem          @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentDraft     ContentDraft?        @relation(fields: [contentDraftId], references: [id], onDelete: SetNull)

  @@index([contentItemId, createdAt])
  @@index([contentDraftId])
  @@map("content_approvals")
}

model ContentPublication {
  id             String                    @id @default(cuid())
  contentItemId  String
  contentDraftId String
  channel        ContentPublicationChannel
  state          ContentPublishState       @default(pending)
  externalPostId String?
  externalUrl    String?                   @db.Text
  idempotencyKey String?                   @unique
  publishedAt    DateTime?
  errorCode      String?
  errorDetail    String?                   @db.Text
  retryCount     Int                       @default(0)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  contentItem    ContentItem               @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentDraft   ContentDraft              @relation(fields: [contentDraftId], references: [id], onDelete: Restrict)
  metrics        ContentMetric[]

  /// Идемпотентность публикации по задаче F.
  @@unique([contentDraftId, channel])
  @@index([channel, state])
  @@index([externalPostId])
  @@map("content_publications")
}

/// Срезы эффективности (агрегаты; детализация по UTM/сессиям — в analytics + propertiesJson).
model ContentMetric {
  id                   String                     @id @default(cuid())
  contentItemId        String
  contentPublicationId String?
  sourceId             String?
  channel              ContentPublicationChannel?
  publishedAt          DateTime?
  utmSource            String?
  utmCampaign          String?
  asOfDate             DateTime                   @db.Date
  views                Int                        @default(0)
  clicks               Int                        @default(0)
  leads                Int                        @default(0)
  applications         Int                        @default(0)
  siteSessions         Int                        @default(0)
  bookingCount         Int                        @default(0)
  /// Агрегат выручки (₽), только проверенные сделки с атрибуцией к content_item
  revenueRub           Int                        @default(0)
  propertiesJson       Json?
  contentItem          ContentItem                @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  contentPublication   ContentPublication?        @relation(fields: [contentPublicationId], references: [id], onDelete: SetNull)
  source               Source?                    @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([contentItemId, asOfDate])
  @@index([sourceId, asOfDate])
  @@index([channel, publishedAt])
  @@map("content_metrics")
}

