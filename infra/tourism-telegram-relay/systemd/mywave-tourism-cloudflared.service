[Unit]
Description=MyWave Tourism Cloudflare quick tunnel
After=network-online.target wg-quick@wg0.service
Wants=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=mywave-relay
Group=mywave-relay
EnvironmentFile=/etc/mywave-tourism/eu.env
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=HOME=/var/lib/mywave-tourism-cloudflared
StateDirectory=mywave-tourism-cloudflared
ExecStart=/usr/bin/env cloudflared tunnel --no-autoupdate --protocol ${CLOUDFLARED_PROTOCOL} --edge-ip-version ${CLOUDFLARED_EDGE_IP_VERSION} --url ${CLOUDFLARED_ORIGIN_URL}
Restart=always
RestartSec=5s
TimeoutStopSec=20s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mywave-tourism-cloudflared
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mywave-tourism-cloudflared
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
